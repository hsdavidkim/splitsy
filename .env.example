# Copy this file to `.env` and fill in real values. Never commit `.env`.

# --- Database (Postgres / Neon) ---
# From the Neon dashboard → "Connect". Copy the connection string it shows and
# paste it here (the default, non-pooled string is fine at this scale).
DATABASE_URL="postgresql://USER:PASSWORD@ep-xxxx.REGION.aws.neon.tech/DBNAME?sslmode=require"

# --- Auth ---
# Signs session cookies. Generate with:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_SECRET="change-me-to-a-long-random-hex-string"

# --- Feature flags ---
# Public sign-ups OFF by default. Set to "true" only to seed the first accounts.
ALLOW_SIGNUPS="false"

# --- Email (Resend) ---
# Powers email verification, password reset, and group invite links.
# Without RESEND_API_KEY the app logs emails to the console instead of sending
# them, so everything still works locally. In production, EMAIL_FROM must use a
# domain you've verified in Resend. APP_URL builds the links inside emails
# (e.g. https://your-app.vercel.app); if unset it's derived from the request.
RESEND_API_KEY=""
EMAIL_FROM="Splitsy <onboarding@resend.dev>"
APP_URL=""

# --- Splitwise importer (optional; only used by `npm run db:seed`) ---
# The two people's names are read from the CSV header; set their login emails +
# a shared temp password here. Defaults: <slug-of-name>@example.com / changeme123
# IMPORT_EMAIL_A="you@example.com"
# IMPORT_EMAIL_B="partner@example.com"
# IMPORT_PASSWORD="changeme123"
# IMPORT_GROUP_NAME="Household"
